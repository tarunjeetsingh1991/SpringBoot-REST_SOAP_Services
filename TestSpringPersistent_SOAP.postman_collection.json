    {
      "name": "Get Tree By ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:tre=\"http://testSpring.com/trees\">\n    <soapenv:Header/>\n    <soapenv:Body>\n        <tre:getTreeRequest>\n            <tre:id>101</tre:id>\n        </tre:getTreeRequest>\n    </soapenv:Body>\n</soapenv:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/ws",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ws"
          ]
        }
      }
    },
